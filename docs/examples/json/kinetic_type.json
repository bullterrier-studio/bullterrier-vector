{
  "version": 1,
  "params": {
    "weight": {
      "default": 600,
      "min": 100,
      "max": 780,
      "unit": "",
      "meaning": "how heavy the letters are, before a pulse"
    },
    "rise": { "default": 0, "min": 0, "max": 1, "unit": "fraction", "meaning": "how far the blue plane has risen" },
    "ink": { "default": 0, "min": 0, "max": 1, "unit": "fraction", "meaning": "0: hairlines only; 1: the riso print" },
    "burst": { "default": 0, "min": 0, "max": 1, "unit": "fraction", "meaning": "how hard the last hit was" },
    "pulse": { "default": 0, "min": 0, "max": 1, "unit": "fraction", "meaning": "a kick, per letter" }
  },
  "inputs": { "anybody": { "kind": "font" } },
  "drawings": {
    "letters": [
      {
        "text": {
          "content": "NO\nSLEEP",
          "font": "anybody",
          "size": 560,
          "axes": { "wght": { "add": [{ "param": "weight" }, { "mul": [120, { "param": "pulse" }] }] } },
          "leading": 520,
          "anchor": [540, 600],
          "align": "center",
          "width": 980,
          "fit": "wdth"
        }
      },
      { "scale": { "by": { "add": [1, { "mul": [0.08, { "param": "pulse" }] }] } } },
      { "rotate": { "angle": { "mul": [{ "random": { "low": -10, "high": 10, "seed": 7 } }, { "param": "burst" }] } } },
      {
        "translate": {
          "dx": { "mul": [{ "random": { "low": -30, "high": 30, "seed": 8 } }, { "param": "burst" }] },
          "dy": { "mul": [{ "random": { "low": -50, "high": 50, "seed": 9 } }, { "param": "burst" }] }
        }
      }
    ],
    "frame": [{ "path": "M0 0 L1080 0 L1080 1350 L0 1350 Z" }]
  },
  "root": [
    {
      "stack": {
        "items": [
          [{ "drawing": "frame" }, { "fill": { "color": "#f3eee4" } }],
          [
            { "drawing": "frame" },
            { "translate": { "dx": 0, "dy": { "mul": [1350, { "sub": [1, { "param": "rise" }] }] } } },
            {
              "subtract": {
                "other": [
                  { "drawing": "letters" },
                  {
                    "translate": {
                      "dx": { "add": [3, { "mul": [14, { "param": "burst" }] }] },
                      "dy": { "mul": [0.6, { "add": [3, { "mul": [14, { "param": "burst" }] }] }] }
                    }
                  }
                ]
              }
            },
            { "fill": { "color": "#2a5bff" } },
            { "blend": { "mode": "multiply" } }
          ],
          [
            { "drawing": "letters" },
            { "fill": { "color": "#ff4f9a" } },
            { "blend": { "mode": "multiply" } },
            { "opacity": { "alpha": { "param": "ink" } } }
          ],
          [
            { "drawing": "letters" },
            { "stroke": { "color": "#16151a", "width": 1.5 } },
            { "opacity": { "alpha": { "sub": [1, { "param": "ink" }] } } }
          ]
        ],
        "size": [1080, 1350]
      }
    }
  ]
}
