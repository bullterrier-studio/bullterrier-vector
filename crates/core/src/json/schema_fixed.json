{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bullterrier-vector drawing, format version 1",
  "$comment": "Generated from the library's own declarations of its calls (verbs()); docs/formats.md. Checks that relate values across a document (an undeclared Param, a default outside its range, depth through references, the Params, inputs and shared drawings a document uses) are the loader's: 'Checked by the loader, not the schema'.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "root"],
  "properties": {
    "version": { "const": 1 },
    "params": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/param" },
      "$comment": "in the order the drawing first reads them; names unique (the loader checks both)"
    },
    "inputs": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": { "$ref": "#/$defs/input" }
    },
    "drawings": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": { "$ref": "#/$defs/drawing" }
    },
    "root": { "$ref": "#/$defs/drawing" }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*(?![\\s\\S])" },
    "tag": { "type": "string", "pattern": "^[\\x20-\\x7E]{4}(?![\\s\\S])" },
    "color": { "type": "string", "pattern": "^#([0-9A-Fa-f]{3}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})(?![\\s\\S])" },
    "point": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }],
      "minItems": 2,
      "items": false
    },
    "stops": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "array",
        "prefixItems": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "$ref": "#/$defs/color" }],
        "minItems": 2,
        "items": false
      },
      "$comment": "offsets must not decrease (the loader checks it)"
    },
    "gradient": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["gradient", "stops", "from", "to"],
          "properties": {
            "gradient": { "const": "linear" },
            "stops": { "$ref": "#/$defs/stops" },
            "from": { "$ref": "#/$defs/point" },
            "to": { "$ref": "#/$defs/point" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["gradient", "stops", "center", "radius"],
          "properties": {
            "gradient": { "const": "radial" },
            "stops": { "$ref": "#/$defs/stops" },
            "center": { "$ref": "#/$defs/point" },
            "radius": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      ],
      "$comment": "in design pixels of the frame; from and to differ, coordinates within +-1e100 (the loader checks both)"
    },
    "field": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "propertyNames": {
        "enum": ["Field.ramp", "Field.distance", "Field.map", "Field.noise", "Field.add", "Field.mul", "Field.min", "Field.max", "Field.abs"]
      },
      "properties": {
        "Field.ramp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start": { "$ref": "#/$defs/literal_point" },
            "end": { "$ref": "#/$defs/literal_point" }
          },
          "required": ["start", "end"]
        },
        "Field.distance": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "drawing": { "$ref": "#/$defs/drawing" }, "normalized": { "type": "boolean" } },
          "required": ["drawing"]
        },
        "Field.map": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 },
            "data": { "$ref": "#/$defs/name" },
            "frame": {
              "type": "array",
              "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }, { "type": "number" }],
              "minItems": 4,
              "items": false
            }
          },
          "required": ["width", "height", "data"]
        },
        "Field.noise": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "wavelength": { "$ref": "#/$defs/number" },
            "phase": { "$ref": "#/$defs/number" },
            "seed": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
            "octaves": { "type": "integer", "minimum": 1, "maximum": 8 }
          }
        },
        "Field.add": { "$ref": "#/$defs/field_sum_operands" },
        "Field.mul": { "$ref": "#/$defs/field_sum_operands" },
        "Field.min": { "$ref": "#/$defs/field_operands" },
        "Field.max": { "$ref": "#/$defs/field_operands" },
        "Field.abs": { "allOf": [{ "$ref": "#/$defs/field_operand" }, { "not": { "type": "number" } }] }
      },
      "$comment": "a number or an expression of Params is the same value everywhere; the ramp's points are literals and differ; data names an input of kind map holding width times height bytes (the loader checks both); the box has a width and a height above 0; noise's wavelength is from 1e-200 to 1e100 when drawn; arithmetic nests at most 16 deep and reads at most 10,000 fields and operations (the loader checks both)"
    },
    "field_operand": { "anyOf": [{ "$ref": "#/$defs/number" }, { "$ref": "#/$defs/field" }] },
    "field_operands": {
      "type": "array",
      "prefixItems": [{ "$ref": "#/$defs/field_operand" }, { "$ref": "#/$defs/field_operand" }],
      "minItems": 2,
      "items": false,
      "not": { "prefixItems": [{ "type": "number" }, { "type": "number" }] },
      "$comment": "two operands that are not both numbers: write the number they make"
    },
    "field_sum_operands": {
      "allOf": [
        { "$ref": "#/$defs/field_operands" },
        { "not": { "prefixItems": [{ "$ref": "#/$defs/number" }, { "$ref": "#/$defs/number" }] } }
      ],
      "$comment": "add and mul of two numbers or expressions make an expression: write it"
    },
    "literal_point": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }],
      "minItems": 2,
      "items": false
    },
    "flow": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "propertyNames": { "enum": ["Flow.angle", "Flow.noise", "Flow.contour", "Flow.mix", "Flow.rotate"] },
      "properties": {
        "Flow.angle": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "angle": { "$ref": "#/$defs/number" } },
          "required": ["angle"]
        },
        "Flow.noise": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "wavelength": { "$ref": "#/$defs/number" },
            "phase": { "$ref": "#/$defs/number" },
            "seed": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 }
          }
        },
        "Flow.contour": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "drawing": { "$ref": "#/$defs/drawing" } },
          "required": ["drawing"]
        },
        "Flow.mix": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "flow": { "$ref": "#/$defs/flow" },
            "other": { "$ref": "#/$defs/flow" },
            "fraction": { "$ref": "#/$defs/number" }
          },
          "required": ["flow", "other", "fraction"]
        },
        "Flow.rotate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "flow": { "$ref": "#/$defs/flow" },
            "angle": { "$ref": "#/$defs/once" }
          },
          "required": ["flow", "angle"]
        }
      },
      "$comment": "numbers may be expressions of Params, read once (no per-item number); wavelength is above 0 and a fraction from 0 to 1 when drawn; mixes and turns nest at most 16 deep and a flow holds at most 64 flows (the loader checks them)"
    },
    "path_data": { "type": "string", "pattern": "^(\\s*[Mm][MmZzLlHhVvCcSsQqTtAa0-9eE.,+\\-\\s]*)?$" },
    "number": { "anyOf": [{ "type": "number" }, { "$ref": "#/$defs/expression" }] },
    "param_name": {
      "allOf": [{ "$ref": "#/$defs/name" }, { "not": { "enum": ["into", "pen_width", "tolerance", "unit", "window"] } }],
      "$comment": "into, pen_width, tolerance, unit and window are output options in Python, so no Param may take them"
    },
    "operands": {
      "type": "array",
      "prefixItems": [{ "$ref": "#/$defs/number" }, { "$ref": "#/$defs/number" }],
      "minItems": 2,
      "items": false,
      "not": { "items": { "type": "number" } },
      "$comment": "at least one operand is not a literal: a constant expression is written as its value"
    },
    "whole": {
      "anyOf": [{ "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 }, { "$ref": "#/$defs/expression" }],
      "$comment": "a seed: a whole number within +-(2^53 - 1) when drawn"
    },
    "once": { "anyOf": [{ "type": "number" }, { "$ref": "#/$defs/once_expression" }] },
    "once_operands": {
      "type": "array",
      "prefixItems": [{ "$ref": "#/$defs/once" }, { "$ref": "#/$defs/once" }],
      "minItems": 2,
      "items": false,
      "not": { "items": { "type": "number" } }
    },
    "once_expression": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "propertyNames": { "enum": ["param", "add", "sub", "mul", "div", "neg"] },
      "properties": {
        "param": { "$ref": "#/$defs/name" },
        "add": { "$ref": "#/$defs/once_operands" },
        "sub": { "$ref": "#/$defs/once_operands" },
        "mul": { "$ref": "#/$defs/once_operands" },
        "div": { "allOf": [{ "$ref": "#/$defs/once_operands" }, { "prefixItems": [true, { "not": { "const": 0 } }] }] },
        "neg": { "allOf": [{ "$ref": "#/$defs/once" }, { "not": { "type": "number" } }] }
      },
      "$comment": "an expression without per-item numbers, for an argument read once rather than per shape"
    },
    "expression": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "propertyNames": { "enum": ["param", "add", "sub", "mul", "div", "neg", "by_index", "by_order", "random", "stagger"] },
      "properties": {
        "param": { "$ref": "#/$defs/name" },
        "add": { "$ref": "#/$defs/operands" },
        "sub": { "$ref": "#/$defs/operands" },
        "mul": { "$ref": "#/$defs/operands" },
        "div": { "allOf": [{ "$ref": "#/$defs/operands" }, { "prefixItems": [true, { "not": { "const": 0 } }] }] },
        "neg": { "allOf": [{ "$ref": "#/$defs/number" }, { "not": { "type": "number" } }] },
        "by_index": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "first": { "$ref": "#/$defs/number" }, "last": { "$ref": "#/$defs/number" } },
          "required": ["first", "last"]
        },
        "by_order": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "first": { "$ref": "#/$defs/number" }, "last": { "$ref": "#/$defs/number" } },
          "required": ["first", "last"]
        },
        "random": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "low": { "$ref": "#/$defs/number" }, "high": { "$ref": "#/$defs/number" }, "seed": { "$ref": "#/$defs/whole" } },
          "required": ["low", "high"]
        },
        "stagger": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "progress": { "$ref": "#/$defs/number" },
            "spread": { "anyOf": [{ "type": "number", "minimum": 0, "exclusiveMaximum": 1 }, { "$ref": "#/$defs/expression" }] }
          },
          "required": ["progress"]
        }
      }
    },
    "drawing": {
      "type": "array",
      "minItems": 1,
      "prefixItems": [{ "$ref": "#/$defs/source" }],
      "items": { "$ref": "#/$defs/step" },
      "$comment": "a source, then the steps applied to it in order"
    },
    "param": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/param_name" },
        "default": { "type": "number" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "unit": { "enum": ["px", "deg", "cycle", "fraction", ""] },
        "meaning": { "type": "string" }
      },
      "required": ["name", "default", "min", "max", "unit", "meaning"]
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "kind": { "enum": ["font", "map"] }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])" } },
      "required": ["kind"]
    }
  }
}
